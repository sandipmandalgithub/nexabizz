generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EnquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ContactEnquiry {
  id             String        @id @default(cuid())
  fullName       String
  company        String?
  email          String
  phone          String
  service        String
  budget         String
  timeline       String
  projectDetails String        @db.Text
  status         EnquiryStatus @default(NEW)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([createdAt])
  @@index([email])
  @@index([status])
  @@map("contact_enquiries")
}

model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}

model Project {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  category     String
  description  String   @db.Text
  imageUrl     String?
  technologies String[] @default([])
  liveUrl      String?
  githubUrl    String?
  featured     Boolean  @default(false)
  published    Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published])
  @@index([featured])
  @@index([sortOrder])
  @@map("projects")
}

model Blog {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String    @db.Text
  content         String    @db.Text
  coverImage      String?
  category        String
  tags            String[]  @default([])
  author          String    @default("NexaBizz Team")
  readTime        Int       @default(5)
  featured        Boolean   @default(false)
  published       Boolean   @default(false)
  publishedAt     DateTime?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([published])
  @@index([featured])
  @@index([category])
  @@index([publishedAt])
  @@index([sortOrder])
  @@map("blogs")
}