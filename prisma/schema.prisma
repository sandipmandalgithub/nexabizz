generator client {
provider = "prisma-client-js"
}

datasource db {
provider = "postgresql"
url      = env("DATABASE_URL")
}

model ContactEnquiry {
id            String   @id @default(cuid())
fullName      String
company       String?
email         String
phone         String
service       String
budget        String
timeline      String
projectDetails String  @db.Text
createdAt     DateTime @default(now())
updatedAt     DateTime @updatedAt

@@index([createdAt])
@@index([email])
@@map("contact_enquiries")
}
